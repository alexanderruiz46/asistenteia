          <mxGeometry x="400" y="60" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="stt4" value="SpeechRecognition&#xa;o webkitSpeechRecognition&#xa;lang: es-*&#xa;interimResults: true" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ef6c00;fontSize=11;" vertex="1" parent="stt-lane">
          <mxGeometry x="590" y="60" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="stt5" value="onresult&#xa;transcript →&#xa;#user-input" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ef6c00;fontSize=11;" vertex="1" parent="stt-lane">
          <mxGeometry x="820" y="60" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="stt6" value="requestSubmit()&#xa;envía chat&#xa;como texto" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ef6c00;fontSize=11;" vertex="1" parent="stt-lane">
          <mxGeometry x="1000" y="60" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="stt-note" value="iOS: requiere Safari iOS 14.5+ y permiso de Micrófono en Ajustes → Safari.&#xa;Android: Chrome con permiso de micrófono. Errores not-allowed / no-speech se muestran en UI." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#ff8f00;align=left;fontSize=11;" vertex="1" parent="stt-lane">
          <mxGeometry x="40" y="170" width="1110" height="70" as="geometry" />
        </mxCell>

        <!-- TTS -->
        <mxCell id="tts-lane" value="HABLAR — Text-to-Speech (TTS)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontStyle=1;fontSize=14;startSize=36;" vertex="1" parent="1">
          <mxGeometry x="40" y="390" width="1320" height="300" as="geometry" />
        </mxCell>
        <mxCell id="tts1" value="Respuesta del bot&#xa;llega a app.js" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1565c0;fontSize=11;" vertex="1" parent="tts-lane">
          <mxGeometry x="40" y="60" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="tts2" value="¿audioUnlocked?&#xa;Si NO → pendingSpeak&#xa;(típico tras fetch iOS)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1565c0;fontSize=11;" vertex="1" parent="tts-lane">
          <mxGeometry x="230" y="45" width="180" height="100" as="geometry" />
        </mxCell>
        <mxCell id="tts3" value="Auto speak()&#xa;primera oración&#xa;+ pause/resume iOS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1565c0;fontSize=11;" vertex="1" parent="tts-lane">
          <mxGeometry x="460" y="60" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="tts4" value="Botón Escuchar&#xa;speakFromUserGesture()&#xa;fallback iPhone" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#e65100;fontSize=11;fontStyle=1;" vertex="1" parent="tts-lane">
          <mxGeometry x="680" y="60" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="tts5" value="speechSynthesis&#xa;SpeechSynthesisUtterance&#xa;voz es (Paulina/Mónica/…)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1565c0;fontSize=11;" vertex="1" parent="tts-lane">
          <mxGeometry x="900" y="60" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="tts-note" value="Claves iOS:&#xa;1) Safari bloquea TTS sin gesto del usuario → unlock en primer touch/click o al tocar micrófono.&#xa;2) Tras await fetch, el auto-speak puede no sonar → botón Escuchar fuerza reproducción con gesto.&#xa;3) Hack pause()/resume() tras speak() para despertar el motor de voz en iPhone.&#xa;4) No buscar voces con nombre &quot;female&quot; (falla en iOS); se eligen Paulina, Mónica, Sabina, etc." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1976d2;align=left;fontSize=11;" vertex="1" parent="tts-lane">
          <mxGeometry x="40" y="160" width="1060" height="110" as="geometry" />
        </mxCell>

        <mxCell id="comp" value="Comparativa rápida&#xa;&#xa;iOS Safari: unlock + permiso mic + botón Escuchar&#xa;Android Chrome: STT/TTS más permisivos, mismo código&#xa;Desktop: funciona con click; Chrome tiene buen STT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#616161;align=left;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="720" width="640" height="120" as="geometry" />
        </mxCell>
        <mxCell id="files-v" value="Archivos involucrados&#xa;&#xa;public/voice.js — clase VoiceAssistant&#xa;public/app.js — init + speak + botón Escuchar&#xa;public/index.html — mic UI + carga scripts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825;align=left;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="720" y="720" width="640" height="120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="estructura-repo" name="4. Estructura Repo + CI/CD">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="tr" value="Estructura del repositorio y pipeline de despliegue" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontStyle=1;fontSize=18;fontColor=#00695c;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1320" height="40" as="geometry" />
        </mxCell>

        <mxCell id="tree" value="asistenteia/&#xa;├── public/                 ← Firebase Hosting (app real)&#xa;│   ├── index.html&#xa;│   ├── app.js&#xa;│   ├── voice.js&#xa;│   ├── styles.css&#xa;│   ├── swagger.yaml / swagger-ui.html&#xa;│   └── assets (favicon, manifest)&#xa;├── functions/              ← Cloud Functions Node 22&#xa;│   ├── index.js            ← Express api (health + chat)&#xa;│   ├── config/asistente.js ← modelo + systemPrompt&#xa;│   ├── utils/textUtils.js  ← normalizeText&#xa;│   └── package.json&#xa;├── src/                    ← plantilla React (no es el hosting actual)&#xa;├── docs/&#xa;│   └── arquitectura-aloxter.drawio&#xa;├── .github/workflows/&#xa;│   └── firebase-deploy.yml&#xa;├── firebase.json&#xa;├── .firebaserc             ← project asistenteia-185c4&#xa;└── README.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#455a64;align=left;fontFamily=Courier New;fontSize=11;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="520" height="420" as="geometry" />
        </mxCell>

        <mxCell id="pipe" value="Pipeline CI/CD" style="swimlane;whiteSpace=wrap;html=1;fillColor=#e0f7fa;strokeColor=#00838f;fontStyle=1;startSize=30;" vertex="1" parent="1">
          <mxGeometry x="600" y="80" width="720" height="280" as="geometry" />
        </mxCell>
        <mxCell id="p1" value="git push main&#xa;GitHub" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#00838f;fontSize=11;" vertex="1" parent="pipe">
          <mxGeometry x="30" y="60" width="120" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="Actions&#xa;checkout&#xa;Node 22&#xa;npm install" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#00838f;fontSize=11;" vertex="1" parent="pipe">
          <mxGeometry x="180" y="60" width="130" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="firebase deploy&#xa;hosting + functions&#xa;FIREBASE_TOKEN&#xa;--force" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#00838f;fontSize=11;" vertex="1" parent="pipe">
          <mxGeometry x="340" y="60" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p4" value="Verify&#xa;/api/health&#xa;+ web.app HTML" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#00838f;fontSize=11;" vertex="1" parent="pipe">
          <mxGeometry x="520" y="60" width="140" height="70" as="geometry" />
